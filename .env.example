# ---------------------------------------------------------------------------
# US360 environment variables
# Copy this file to .env and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL)
# On Vercel: DATABASE_URL = pooled URL, DIRECT_URL = non-pooling URL
# Locally both can be the same.
DATABASE_URL=postgresql://us360:us360_dev_password@localhost:5432/us360?schema=public
DIRECT_URL=postgresql://us360:us360_dev_password@localhost:5432/us360?schema=public

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# Optional Google OAuth (sign-in) — also used for Connect Gmail unless GMAIL_GOOGLE_* is set
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Personal Gmail sending (official OAuth + Gmail API). Never put these in NEXT_PUBLIC_*.
# GMAIL_GOOGLE_ID=
# GMAIL_GOOGLE_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
# Operator-only: do not enable a shared SMTP mailbox for all users.
# SMTP_ALLOW_SHARED_FALLBACK=false

# AI provider (OpenAI by default; swap via AI_PROVIDER)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1200
AI_DAILY_USER_LIMIT=40

# Image generation (optional; falls back to CSS/HTML card backgrounds)
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_MODEL=dall-e-3

# S3-compatible object storage (optional)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Email is per-user Gmail OAuth (see GMAIL_REDIRECT_URI above). Do not use one SMTP mailbox for everyone.

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Meta / Instagram Graph API (official OAuth only)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
INSTAGRAM_SCOPES=instagram_basic,instagram_content_publish

# Token encryption for stored integration tokens
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex-or-passphrase

# Cron / job runner (protect scheduled endpoints)
CRON_SECRET=replace-with-a-long-random-secret

# Admin panel access (comma-separated emails)
ADMIN_EMAILS=admin@example.com

# WhatsApp chat import does not require these. Reminders and Reels are never auto-sent on WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE=us360_reminder
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_VERIFY_TOKEN=
# Optional Graph-compatible endpoint if you use an approved provider instead of api.facebook.com
WHATSAPP_API_BASE=

# Optional live restaurant / place search (official APIs only — never scrape)
# If unset, US360 uses the built-in Pakistan city catalog and labels it as catalog (not live-verified).
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=

